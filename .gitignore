# Python
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 環境変数（実値は絶対にコミットしない）
.env

# ローカル専用の非公開ノート（パスワード等を含むため、リモートには一切含めない）
obsidian_vault/private/

# OneNoteエクスポート由来のメモ（技術Tipsと実際の認証情報・個人情報が混在するため、リモートには一切含めない）
obsidian_vault/raw/apple_memo/

# Obsidian（ワークスペース固有の設定は個人環境依存のため除外）
# 注意: Vaultルートはリポジトリのトップレベルではなくobsidian_vault/配下（CLAUDE.md 2節）。
# 「/」を含むパターンはgitignore仕様上.gitignoreのある階層（リポジトリ直下）からの相対パスと
# みなされるため、obsidian_vault/を明記しないとobsidian_vault/.obsidian/配下にマッチしない。
obsidian_vault/.obsidian/workspace*
obsidian_vault/.obsidian/cache

# Smart Connections（埋め込みインデックスは再生成可能なローカルキャッシュのため除外）
obsidian_vault/.obsidian/plugins/smart-connections/
obsidian_vault/.smart-env/

# OS
Thumbs.db
.DS_Store
